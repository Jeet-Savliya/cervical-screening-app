# Copy this file to `.env` in the same folder and fill in a real value.
# A long random string is fine — e.g. generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=9eb3d5a0531903169c06c7effe7b2171c0c1642aaccdaf4f8e4cdea7e4841c9a

# Optional: how long a login stays valid, in minutes. Defaults to 480 (8 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Production database (leave unset to use local SQLite automatically) ---
# Your Supabase (or Neon) Postgres connection string. Example:
DATABASE_URL=postgresql://postgres.wiszowdgeifusqcrfmjy:jeetsavliya072@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# --- Production photo storage (leave all unset to use local disk automatically) ---
# Works with Supabase Storage, Cloudflare R2, or any other S3-compatible provider.
# For Supabase Storage, get these values from Project Settings -> Storage -> S3 Connection:
S3_ENDPOINT_URL=https://wiszowdgeifusqcrfmjy.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=f086dc3701eb13ebe803df2e62fa0374
S3_SECRET_ACCESS_KEY=9fe12d4ee9efc6c741655e365f121c2f44d7aac7be3f31afa41cf6968c3a3227
S3_BUCKET_NAME=patient-photos
S3_PUBLIC_URL=https://wiszowdgeifusqcrfmjy.supabase.co/storage/v1/object/public/patient-photos

# The publicly reachable URL of this backend itself (used to build local-mode image URLs;
# not needed once R2 is configured, since R2_PUBLIC_URL is used instead).
# BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# Comma-separated list of frontend URLs allowed to call this API.
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173